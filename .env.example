# Copy to .env and adjust. .env is git-ignored.

# development | testing | production
FLASK_ENV=development

# Required in production; a weak default is used otherwise.
SECRET_KEY=change-me

# Override the database. Defaults to sqlite:///instance/superlist.db
# DATABASE_URL=sqlite:////absolute/path/to/superlist.db

# Dev server (run.py)
PORT=5002
